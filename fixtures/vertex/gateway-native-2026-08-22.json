    {
      "name": "count-tokens",
      "method": "POST",
      "downstream_path": "/v1beta/models/gemini-2.5-pro:countTokens",
      "upstream_path": "/v1/projects/test-project/locations/us-central1/publishers/google/models/gemini-2.5-pro:countTokens",
