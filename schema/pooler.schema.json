          "enum": [
            "credential",
            "credential_model",
            "model",
            "provider",
            "provider_model",
            "route"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "duration": {
      "oneOf": [
        {
          "pattern": "^[0-9]+(ms|s|m|h)$",
          "type": "string"
        },
        {
          "minimum": 0,
          "type": "integer"
        }
      ]
    },
    "extension": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "args": {
              "items": {
                "type": "string"
              },
              "maxItems": 64,
              "minItems": 0,
              "type": "array"
            },
            "capabilities": {
              "items": {
                "enum": [
                  "inspect",
                  "transform"
