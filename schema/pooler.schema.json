          "minItems": 1,
          "type": "array"
        },
        "alpn_protocols": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "cert": {
          "type": "string"
        },
        "cert_file": {
          "type": "string"
        },
        "certificate": {
          "type": "string"
        },
        "certificate_file": {
          "type": "string"
        },
        "client_auth": {
          "$ref": "#/$defs/listener_client_auth"
        },
        "handshake_timeout": {
          "$ref": "#/$defs/duration"
        },
        "key": {
          "type": "string"
        },
        "key_file": {
          "type": "string"
        },
        "private_key": {
          "type": "string"
        },
        "private_key_file": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "management": {
      "additionalProperties": false,
