        "id": {
          "pattern": "^[A-Za-z0-9._-]{1,128}$",
          "type": "string"
        },
        "included_models": {
          "items": {
            "type": "string"
          },
          "maxItems": 1024,
          "minItems": 0,
          "type": "array"
        },
        "max_response_bytes": {
          "maximum": 16777216,
          "minimum": 1,
          "type": "integer"
        },
        "model_facts_provider": {
          "pattern": "^[A-Za-z0-9._-]{1,128}$",
          "type": "string"
        },
        "parser": {
          "enum": [
            "openai",
            "codex",
            "kimi",
            "gemini",
            "vertex",
            "antigravity"
          ],
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "prefix": {
          "type": "string"
        },
        "priority": {
          "maximum": 2147483647,
          "minimum": -2147483648,
          "type": "integer"
        },
        "provider": {
          "pattern": "^[A-Za-z0-9._-]{1,128}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "provider",
        "parser"
      ],
      "type": "object"
