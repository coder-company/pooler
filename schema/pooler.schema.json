          "minItems": 0,
          "type": "array"
        },
        "path": {
          "type": "string"
        },
        "path_prefix": {
          "type": "string"
        },
        "path_template": {
          "type": "string"
        },
        "websocket": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "model": {
      "additionalProperties": false,
      "not": {
        "required": [
          "merge",
          "remove"
        ]
      },
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9._-]{1,128}$",
          "type": "string"
