                "type": "string"
              },
              "maxItems": 2,
              "minItems": 1,
              "type": "array"
            },
            "command": {
              "minLength": 1,
              "type": "string"
            },
            "limits": {
              "$ref": "#/$defs/extension_limits"
            },
            "wasm": {
              "type": "string"
            }
          },
          "required": [
            "command",
            "capabilities"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "args": {
              "items": {
                "type": "string"
              },
              "maxItems": 64,
              "minItems": 0,
              "type": "array"
            },
            "capabilities": {
              "items": {
                "enum": [
                  "inspect",
                  "transform"
                ],
                "type": "string"
              },
              "maxItems": 2,
              "minItems": 1,
              "type": "array"
            },
            "command": {
              "type": "string"
            },
            "limits": {
              "$ref": "#/$defs/extension_limits"
