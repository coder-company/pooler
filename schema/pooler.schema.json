        "allow_remote": {
          "type": "boolean"
        },
        "auth": {
          "$ref": "#/$defs/auth"
        },
        "authentication": {
          "$ref": "#/$defs/auth"
        },
        "bind": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "listen": {
          "type": "string"
