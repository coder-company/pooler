              "tools",
              "reasoning",
              "streaming",
              "usage",
              "structured_output",
              "json_schema",
              "function_calling",
              "tool_choice",
              "cache_hints",
              "continuation",
              "response_metadata",
              "encrypted_reasoning",
              "refusal",
              "error_events",
              "input_audio",
              "output_audio",
              "code_execution",
