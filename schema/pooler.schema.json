                "type": "string"
              },
              "maxItems": 2,
              "minItems": 1,
              "type": "array"
            },
            "command": {
              "minLength": 1,
              "type": "string"
            },
            "limits": {
              "$ref": "#/$defs/extension_limits"
            },
            "wasm": {
              "type": "string"
            }
          },
          "required": [
            "command",
            "capabilities"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "args": {
              "items": {
                "type": "string"
              },
              "maxItems": 64,
              "minItems": 0,
              "type": "array"
            },
            "capabilities": {
              "items": {
                "enum": [
                  "inspect",
                  "transform"
                ],
                "type": "string"
              },
              "maxItems": 2,
              "minItems": 1,
              "type": "array"
            },
            "command": {
              "type": "string"
            },
            "limits": {
              "$ref": "#/$defs/extension_limits"
            },
            "wasm": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "wasm",
            "capabilities"
          ],
          "type": "object"
        }
      ]
    },
    "extension_limits": {
      "additionalProperties": false,
      "properties": {
        "max_concurrency": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "max_input_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "max_memory_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "max_output_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "timeout": {
          "$ref": "#/$defs/duration"
        }
      },
      "type": "object"
    },
    "import": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "file": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "file"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "overlay": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "overlay"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "as": {
              "pattern": "^[A-Za-z0-9._-]{1,128}$",
              "type": "string"
            },
            "preset": {
              "enum": [
                "cursor",
                "devin",
                "factory",
                "fx",
                "media",
                "xai"
              ],
              "type": "string"
