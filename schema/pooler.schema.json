            "wasm": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "wasm",
            "capabilities"
          ],
          "type": "object"
        }
      ]
    },
    "extension_limits": {
      "additionalProperties": false,
      "properties": {
        "max_concurrency": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "max_input_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "max_memory_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "max_output_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "timeout": {
          "$ref": "#/$defs/duration"
        }
      },
      "type": "object"
    },
    "import": {
