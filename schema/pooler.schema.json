        "merge": true,
        "protocol": {
          "enum": [
            "http1",
            "http/1.1",
            "h1",
            "auto",
            "http1+http2",
            "http1-or-http2",
            "h2c",
            "http2",
            "http/2",
            "h2"
          ],
          "type": "string"
        },
        "remove": true,
        "tls": {
          "$ref": "#/$defs/listener_tls"
        }
      },
      "type": "object"
    },
    "listener_client_auth": {
      "additionalProperties": false,
      "properties": {
        "ca": {
          "type": "string"
        },
        "ca_file": {
          "type": "string"
        },
        "certificate_authority": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "listener_tls": {
      "additionalProperties": false,
      "properties": {
        "alpn": {
          "items": {
