{
  "$comment": "Imports and overlay directives are resolved before strict Config parsing; semantic reference and route validation is performed by pooler check.",
  "$defs": {
    "account": {
      "additionalProperties": false,
      "not": {
        "required": [
          "merge",
          "remove"
        ]
      },
      "properties": {
        "auth_kind": {
          "enum": [
            "api_key",
            "oauth"
          ],
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "max_concurrency": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "merge": true,
        "provider": {
          "pattern": "^[A-Za-z0-9._-]{1,128}$",
          "type": "string"
        },
        "quota_project": {
          "pattern": "^[A-Za-z0-9._-]{1,128}$",
          "type": "string"
        },
        "remove": true,
        "secret": {
          "$ref": "#/$defs/secret_ref"
        },
        "weight": {
          "maximum": 4294967295,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "provider"
      ],
      "type": "object"
    },
    "account_pool": {
      "additionalProperties": false,
      "not": {
        "required": [
          "merge",
          "remove"
        ]
      },
      "properties": {
        "accounts": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "merge": true,
        "provider": {
          "pattern": "^[A-Za-z0-9._-]{1,128}$",
          "type": "string"
        },
        "remove": true,
        "strategy": {
          "enum": [
            "round_robin",
            "smooth_weighted_round_robin",
            "fill_first",
            "least_in_flight",
            "health_weighted",
            "ordered_fallback"
          ],
          "type": "string"
        }
      },
      "required": [
        "provider",
        "accounts"
      ],
      "type": "object"
    },
    "affinity": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "rebind": {
          "type": "boolean"
        },
        "ttl": {
          "$ref": "#/$defs/duration"
        }
      },
      "type": "object"
    },
    "auth": {
      "additionalProperties": false,
      "properties": {
        "header": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "bearer",
            "bearer_secret",
            "x-api-key",
            "x_api_key",
            "x-goog-api-key",
            "x_goog_api_key",
            "header"
          ],
          "type": "string"
        },
        "secret": {
          "$ref": "#/$defs/secret_ref"
        },
        "value_prefix": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "body": {
      "additionalProperties": false,
      "properties": {
        "decoder": {
          "type": "string"
        },
        "encoder": {
          "type": "string"
        },
        "framing": {
          "type": "string"
        },
        "inspectors": {
          "items": {
            "type": "string"
          },
          "minItems": 0,
          "type": "array"
        },
        "mode": {
          "enum": [
            "opaque",
            "inspect",
            "patch",
            "semantic"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "cache": {
      "additionalProperties": false,
      "properties": {
        "coalesce": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "key_headers": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 0,
          "type": "array"
        },
        "max_bytes": {
          "oneOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^\\s*[0-9]+(b|kb|kib|mb|mib|gb|gib)\\s*$",
              "type": "string"
            }
          ]
        },
        "max_entries": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "ttl": {
          "$ref": "#/$defs/duration"
        }
      },
      "type": "object"
    },
    "catalog": {
      "additionalProperties": false,
      "properties": {
        "overrides": {
          "items": {
            "$ref": "#/$defs/catalog_model_override"
          },
          "maxItems": 1024,
          "minItems": 0,
          "type": "array"
        },
        "refresh": {
          "$ref": "#/$defs/catalog_refresh"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/catalog_source"
          },
          "maxItems": 1024,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "sources"
      ],
      "type": "object"
    },
    "catalog_alias": {
      "additionalProperties": false,
      "properties": {
        "alias": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "force_mapping": {
          "type": "boolean"
        },
        "fork": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "alias"
      ],
      "type": "object"
    },
    "catalog_model_override": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {
            "enum": [
              "text",
              "images",
              "audio",
              "files",
              "tools",
              "reasoning",
              "streaming",
              "usage",
              "structured_output",
              "json_schema",
              "function_calling",
              "tool_choice",
              "cache_hints",
              "continuation",
              "response_metadata",
              "encrypted_reasoning",
              "refusal",
              "error_events",
              "input_audio",
              "output_audio",
              "code_execution",
              "computer_use",
              "batch",
              "embeddings",
              "sse",
              "web_socket",
              "connect_rpc",
              "protobuf"
            ],
            "type": "string"
          },
          "minItems": 0,
          "type": "array"
        },
        "dialect": {
          "$ref": "#/$defs/model_dialect"
        },
        "disabled": {
          "type": "boolean"
        },
        "display_name": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/model_profile"
        },
        "request": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "model"
      ],
      "type": "object"
    },
    "catalog_refresh": {
      "additionalProperties": false,
      "properties": {
        "max_concurrency": {
          "maximum": 64,
          "minimum": 1,
          "type": "integer"
        },
        "max_merge_operations": {
          "maximum": 20000000,
          "minimum": 1,
          "type": "integer"
        },
        "max_models_per_source": {
          "maximum": 50000,
          "minimum": 1,
          "type": "integer"
        },
        "max_sources": {
          "maximum": 1024,
          "minimum": 1,
          "type": "integer"
        },
        "max_total_models": {
          "maximum": 100000,
          "minimum": 1,
          "type": "integer"
        },
        "timeout_ms": {
          "maximum": 300000,
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "catalog_source": {
      "additionalProperties": false,
      "properties": {
        "account": {
          "pattern": "^[A-Za-z0-9._-]{1,128}$",
          "type": "string"
        },
        "account_pool": {
          "pattern": "^[A-Za-z0-9._-]{1,128}$",
          "type": "string"
        },
        "aliases": {
