{
  "$comment": "Imports and overlay directives are resolved before strict Config parsing; semantic reference and route validation is performed by pooler check.",
  "$defs": {
    "account": {
      "additionalProperties": false,
      "not": {
        "required": [
          "merge",
          "remove"
        ]
      },
      "properties": {
        "auth_kind": {
          "enum": [
            "api_key",
            "oauth",
            "subscription"
          ],
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "max_concurrency": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "merge": true,
        "provider": {
          "type": "string"
        },
        "quota_project": {
          "pattern": "^[A-Za-z0-9._-]{1,128}$",
          "type": "string"
        },
        "remove": true,
        "secret": {
          "$ref": "#/$defs/secret_ref"
        },
        "upstream": {
          "type": "string"
        },
        "weight": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "account_pool": {
      "additionalProperties": false,
      "not": {
        "required": [
          "merge",
          "remove"
        ]
      },
      "properties": {
        "accounts": {
          "items": {
            "type": "string"
          },
          "minItems": 0,
          "type": "array"
        },
        "members": {
          "items": {
            "type": "string"
          },
          "minItems": 0,
          "type": "array"
        },
        "merge": true,
        "remove": true
      },
      "type": "object"
    },
    "affinity": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "rebind": {
          "type": "boolean"
        },
        "ttl": {
          "$ref": "#/$defs/duration"
        }
      },
      "type": "object"
    },
    "auth": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "bearer",
            "bearer_secret",
            "x-api-key",
            "x_api_key",
            "x-goog-api-key",
            "x_goog_api_key"
          ],
          "type": "string"
        },
        "secret": {
          "$ref": "#/$defs/secret_ref"
        }
      },
      "type": "object"
    },
    "body": {
      "additionalProperties": false,
      "properties": {
        "decoder": {
          "type": "string"
        },
        "encoder": {
          "type": "string"
        },
        "framing": {
          "type": "string"
        },
        "inspectors": {
          "items": {
            "type": "string"
          },
          "minItems": 0,
          "type": "array"
        },
        "mode": {
          "enum": [
            "opaque",
            "inspect",
            "patch",
            "semantic"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "cache": {
      "additionalProperties": false,
      "properties": {
        "coalesce": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "key_headers": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 0,
          "type": "array"
        },
        "max_bytes": {
          "oneOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^\\s*[0-9]+(b|kb|kib|mb|mib|gb|gib)\\s*$",
              "type": "string"
            }
          ]
        },
        "max_entries": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "ttl": {
          "$ref": "#/$defs/duration"
        }
      },
      "type": "object"
    },
    "catalog": {
      "additionalProperties": false,
      "properties": {
        "refresh": {
          "$ref": "#/$defs/catalog_refresh"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/catalog_source"
          },
          "maxItems": 1024,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "sources"
      ],
      "type": "object"
    },
    "catalog_alias": {
      "additionalProperties": false,
      "properties": {
        "alias": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "force_mapping": {
          "type": "boolean"
        },
        "fork": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "alias"
      ],
      "type": "object"
    },
    "catalog_refresh": {
      "additionalProperties": false,
      "properties": {
        "max_concurrency": {
          "maximum": 64,
          "minimum": 1,
          "type": "integer"
        },
        "max_merge_operations": {
          "maximum": 20000000,
          "minimum": 1,
          "type": "integer"
        },
        "max_models_per_source": {
          "maximum": 50000,
          "minimum": 1,
          "type": "integer"
        },
        "max_sources": {
          "maximum": 1024,
          "minimum": 1,
          "type": "integer"
        },
        "max_total_models": {
          "maximum": 100000,
          "minimum": 1,
          "type": "integer"
        },
        "timeout_ms": {
          "maximum": 300000,
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "catalog_source": {
      "additionalProperties": false,
      "properties": {
        "account": {
          "pattern": "^[A-Za-z0-9._-]{1,128}$",
          "type": "string"
        },
        "aliases": {
          "items": {
            "$ref": "#/$defs/catalog_alias"
          },
          "maxItems": 1024,
          "minItems": 0,
          "type": "array"
        },
        "excluded_models": {
          "items": {
            "type": "string"
          },
          "maxItems": 1024,
          "minItems": 0,
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z0-9._-]{1,128}$",
          "type": "string"
        },
        "included_models": {
          "items": {
            "type": "string"
          },
          "maxItems": 1024,
          "minItems": 0,
          "type": "array"
        },
        "max_response_bytes": {
          "maximum": 16777216,
          "minimum": 1,
          "type": "integer"
        },
        "model_facts_provider": {
          "pattern": "^[A-Za-z0-9._-]{1,128}$",
          "type": "string"
        },
        "parser": {
          "enum": [
            "openai",
            "open_ai",
            "kimi",
            "vertex",
            "antigravity"
          ],
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "prefix": {
          "type": "string"
        },
        "priority": {
          "maximum": 2147483647,
          "minimum": -2147483648,
          "type": "integer"
        },
        "provider": {
          "pattern": "^[A-Za-z0-9._-]{1,128}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "provider",
        "parser"
      ],
      "type": "object"
    },
    "cooldown": {
      "additionalProperties": false,
      "properties": {
        "duration": {
          "$ref": "#/$defs/duration"
        },
        "scope": {
          "enum": [
            "credential",
            "credential_model",
            "model",
            "provider",
            "provider_model",
            "route"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "duration": {
      "oneOf": [
        {
          "pattern": "^[0-9]+(ms|s|m|h)$",
          "type": "string"
        },
        {
          "minimum": 0,
          "type": "integer"
        }
      ]
    },
    "extension": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "args": {
              "items": {
                "type": "string"
              },
              "maxItems": 64,
              "minItems": 0,
              "type": "array"
            },
            "capabilities": {
              "items": {
                "enum": [
                  "inspect",
                  "transform"
